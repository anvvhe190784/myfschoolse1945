# Cấu hình SMTP gửi email (ví dụ Gmail với Google App Password 16 ký tự)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-char-app-password

# Cấu hình Database PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fschool_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password

# Cấu hình JWT Token Secret (tối thiểu 256-bit base64)
JWT_SECRET=your_base64_jwt_secret_min_256_bit
JWT_EXPIRATION_MS=86400000
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Cấu hình Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6380
