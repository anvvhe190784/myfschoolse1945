            "description": "Xem danh sách toàn bộ các môn học."
          }
        },
        {
          "name": "Create Course (Thêm Môn học)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseCode\": \"ITE302c\",\n  \"courseName\": \"Ethics in Information Technology\",\n  \"credits\": 3,\n  \"description\": \"Đạo đức nghề nghiệp trong ngành Công nghệ thông tin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/academic/courses",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "academic", "courses"]
            },
            "description": "Thêm một môn học mới vào cơ sở dữ liệu."
          }
        },
        {
          "name": "Get All Classes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/academic/classes",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "academic", "classes"]
            },
            "description": "Xem danh sách các lớp học hiện có."
          }
        },
        {
          "name": "Get Student Classes in Semester (Danh sách Lớp học phần của Sinh viên)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/academic/students/{{userId}}/classes?semester=Fall2026",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "academic", "students", "{{userId}}", "classes"],
              "query": [
                {
                  "key": "semester",
                  "value": "Fall2026",
                  "description": "Học kỳ muốn lọc"
                }
              ]
            },
            "description": "Tra cứu tất cả các lớp học phần sinh viên đang theo học trong học kỳ."
          }
        },
        {
          "name": "Create Class (Mở Lớp học)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classCode\": \"SE1945_ITE\",\n  \"courseId\": {{courseId}},\n  \"lecturerId\": 2,\n  \"semester\": \"Fall2026\",\n  \"academicYear\": 2026,\n  \"roomDefault\": \"BE-405\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/academic/classes",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "academic", "classes"]
            },
            "description": "Mở một lớp học mới và phân bổ giảng viên."
          }
        },
        {
          "name": "Create Schedule (Xếp Lịch học)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": {{classId}},\n  \"slotNumber\": 1,\n  \"date\": \"2026-10-25\",\n  \"startTime\": \"07:30:00\",\n  \"endTime\": \"09:50:00\",\n  \"room\": \"BE-301\",\n  \"lecturerId\": 2,\n  \"note\": \"Session 1: Introduction to Mobile Architecture\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/academic/schedules",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "academic", "schedules"]
            },
            "description": "Tạo buổi học mới cho lớp học."
          }
        }
      ]
    },
    {
      "name": "4. Admin - Student Requests Review (Duyệt Đơn từ)",
      "item": [
        {
          "name": "Process Student Request (Phê duyệt / Từ chối)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"responseNote\": \"Đã duyệt đơn xin phép. Chúc em sớm bình phục.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/academic/requests/{{requestId}}/process",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "academic", "requests", "{{requestId}}", "process"]
            },
            "description": "Duyệt hoặc từ chối đơn từ học vụ của sinh viên/phụ huynh."
          }
        }
      ]
    },
    {
      "name": "5. Admin - News & Broadcasts (Đăng Tin tức)",
      "item": [
        {
          "name": "Create News Article (Đăng tin & Gửi thông báo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lịch nghỉ lễ kỷ niệm thành lập trường 2026\",\n  \"summary\": \"Thông báo lịch nghỉ và hoạt động chào mừng ngày thành lập FPT.\",\n  \"content\": \"Nhà trường trân trọng thông báo toàn thể sinh viên và cán bộ giảng viên được nghỉ ngày 20/11.\",\n  \"thumbnailUrl\": \"https://picsum.photos/seed/anniversary/800/400\",\n  \"category\": \"EVENT\"\n}"
